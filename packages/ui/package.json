{
  "name": "@fabrials/ui",
  "version": "0.11.0",
  "description": "The Fabrials design system: tokens, IBM Plex, controls, patterns and the dithered Highstorm brand.",
  "homepage": "https://ui.fabrials.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grok-insider/fabrials-ui.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/grok-insider/fabrials-ui/issues",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./moon": {
      "types": "./dist/moon-math.d.ts",
      "import": "./dist/moon-math.js"
    },
    "./dither": {
      "types": "./dist/dither.d.ts",
      "import": "./dist/dither.js"
    },
    "./spreadsheet": {
      "types": "./dist/spreadsheet-read.d.ts",
      "import": "./dist/spreadsheet-read.js"
    },
    "./export": {
      "types": "./dist/export.d.ts",
      "import": "./dist/export.js"
    },
    "./button-variants": {
      "types": "./dist/button-variants.d.ts",
      "import": "./dist/button-variants.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./layers.css": "./dist/layers.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY.md",
    "DESIGN.md",
    "verify.mjs",
    "integrity.mjs"
  ],
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "cmdk": "1.1.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.68.0",
    "react-resizable-panels": "4.18.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
