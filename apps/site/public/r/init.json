{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "init",
  "type": "registry:base",
  "title": "Fabrials UI",
  "description": "Sets a shadcn app up for Fabrials UI: Base UI primitives, the @fabrials registry, the styles, IBM Plex and the Highstorm palette in light and dark.",
  "dependencies": [
    "@fabrials/ui@^0.12.0"
  ],
  "registryDependencies": [
    "https://ui.fabrials.com/r/styles.json",
    "utils"
  ],
  "files": [],
  "config": {
    "style": "base-nova",
    "iconLibrary": "lucide",
    "registries": {
      "@fabrials": "https://ui.fabrials.com/r/{name}.json"
    }
  },
  "cssVars": {
    "theme": {
      "font-sans": "var(--fui-font-sans)",
      "font-mono": "var(--fui-font-mono)",
      "font-display": "var(--fui-font-display)"
    },
    "light": {
      "background": "oklch(0.988 0 0)",
      "foreground": "oklch(0.14 0 0)",
      "card": "oklch(1 0 0)",
      "card-foreground": "oklch(0.14 0 0)",
      "popover": "oklch(1 0 0)",
      "popover-foreground": "oklch(0.14 0 0)",
      "primary": "oklch(0.14 0 0)",
      "primary-foreground": "oklch(0.988 0 0)",
      "secondary": "oklch(0.95 0 0)",
      "secondary-foreground": "oklch(0.14 0 0)",
      "muted": "oklch(0.95 0 0)",
      "muted-foreground": "oklch(0.46 0 0)",
      "accent": "oklch(0.935 0 0)",
      "accent-foreground": "oklch(0.14 0 0)",
      "destructive": "oklch(0.53 0.16 24)",
      "border": "oklch(0.89 0 0)",
      "input": "oklch(0.86 0 0)",
      "ring": "oklch(0.481 0.154 260)",
      "chart-1": "oklch(0.52 0.15 258)",
      "chart-2": "oklch(0.58 0.09 170)",
      "chart-3": "oklch(0.64 0.12 75)",
      "chart-4": "oklch(0.57 0.14 24)",
      "chart-5": "oklch(0.53 0.12 305)",
      "sidebar": "oklch(0.975 0 0)",
      "sidebar-foreground": "oklch(0.14 0 0)",
      "sidebar-primary": "oklch(0.14 0 0)",
      "sidebar-primary-foreground": "oklch(0.988 0 0)",
      "sidebar-accent": "oklch(0.935 0 0)",
      "sidebar-accent-foreground": "oklch(0.14 0 0)",
      "sidebar-border": "oklch(0.89 0 0)",
      "sidebar-ring": "oklch(0.481 0.154 260)",
      "radius": "0.375rem"
    },
    "dark": {
      "background": "oklch(0.115 0 0)",
      "foreground": "oklch(0.955 0 0)",
      "card": "oklch(0.145 0 0)",
      "card-foreground": "oklch(0.955 0 0)",
      "popover": "oklch(0.165 0 0)",
      "popover-foreground": "oklch(0.955 0 0)",
      "primary": "oklch(0.955 0 0)",
      "primary-foreground": "oklch(0.115 0 0)",
      "secondary": "oklch(0.165 0 0)",
      "secondary-foreground": "oklch(0.955 0 0)",
      "muted": "oklch(0.165 0 0)",
      "muted-foreground": "oklch(0.64 0 0)",
      "accent": "oklch(0.195 0 0)",
      "accent-foreground": "oklch(0.955 0 0)",
      "destructive": "oklch(0.56 0.15 24)",
      "border": "oklch(0.24 0 0)",
      "input": "oklch(0.28 0 0)",
      "ring": "oklch(0.82 0.102 256)",
      "chart-1": "oklch(0.74 0.11 255)",
      "chart-2": "oklch(0.74 0.08 170)",
      "chart-3": "oklch(0.81 0.1 82)",
      "chart-4": "oklch(0.7 0.11 24)",
      "chart-5": "oklch(0.7 0.1 305)",
      "sidebar": "oklch(0.10 0 0)",
      "sidebar-foreground": "oklch(0.955 0 0)",
      "sidebar-primary": "oklch(0.955 0 0)",
      "sidebar-primary-foreground": "oklch(0.10 0 0)",
      "sidebar-accent": "oklch(0.195 0 0)",
      "sidebar-accent-foreground": "oklch(0.955 0 0)",
      "sidebar-border": "oklch(0.22 0 0)",
      "sidebar-ring": "oklch(0.813 0.094 258)"
    }
  },
  "docs": "Fabrials UI is set up. Add components by name, for example: npx shadcn@latest add @fabrials/button @fabrials/mcp-dashboard",
  "meta": {
    "source": "fabrials",
    "license": "MIT",
    "category": "Setup"
  }
}
