{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "init",
  "type": "registry:base",
  "title": "Fabrials UI",
  "description": "Sets a shadcn app up for Fabrials UI: Base UI primitives, the @fabrials registry, the styles, IBM Plex and the Highstorm palette in light and dark.",
  "dependencies": [
    "@fabrials/ui@^0.7.1"
  ],
  "registryDependencies": [
    "https://ui.fabrials.com/r/styles.json",
    "utils"
  ],
  "files": [],
  "config": {
    "style": "base-nova",
    "iconLibrary": "lucide",
    "registries": {
      "@fabrials": "https://ui.fabrials.com/r/{name}.json"
    }
  },
  "cssVars": {
    "theme": {
      "font-sans": "var(--fui-font-sans)",
