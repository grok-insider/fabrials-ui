{
  "name": "fabrials-design-system",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint packages stories tests scripts .storybook --max-warnings=0",
    "test": "bun test packages/ai-ui/tests tests/unit",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build && bun run check:site",
    "storybook": "storybook dev --host 127.0.0.1 -p 6041 --no-open --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "test:visual": "playwright test",
    "test:visual:container": "node scripts/visual.mjs",
    "test:loading": "playwright test --config playwright.loading.config.ts",
    "test:loading:container": "node scripts/loading.mjs",
    "vendor": "node scripts/vendor.mjs",
    "check:site": "bun run --cwd apps/site check && bun run --cwd apps/site test",
    "dev:site": "bun run --cwd apps/site dev",
    "build:site": "bun run build && bun run --cwd apps/site build",
    "registry:build": "bun run --cwd apps/site registry:shims && bun run --cwd apps/site registry:demo-code && bun run --cwd apps/site registry:build",
    "stage:publish": "node scripts/stage-publish.mjs"
  },
  "overrides": {
    "axe-core": "4.14.0",
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    },
    "@joshwooding/vite-plugin-react-docgen-typescript": {
      "glob": "^14.0.3"
    },
    "@ts-morph/common": {
      "minimatch": "^11.0.4"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.4"
    },
    "eslint": {
      "minimatch": "^11.0.4"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@base-ui/react": "1.9.0",
    "@fabrials/ai-ui": "workspace:*",
    "@fabrials/ui": "workspace:*",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.5"
  }
}
