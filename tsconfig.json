{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "react", "react-dom", "vite/client"],
    "paths": {
      "@fabrials/ui": ["./packages/ui/src/index.ts"],
      "@fabrials/ui/button-variants": ["./packages/ui/src/button-variants.ts"],
      "@fabrials/ui/dither": ["./packages/ui/src/dither.ts"],
      "@fabrials/ui/moon": ["./packages/ui/src/moon-math.ts"],
      "@fabrials/ui/spreadsheet": ["./packages/ui/src/spreadsheet-read.ts"],
      "@fabrials/ui/export": ["./packages/ui/src/export.ts"],
      "@fabrials/ai-ui": ["./packages/ai-ui/src/index.tsx"],
      "@fabrials/ai-ui/markdown": ["./packages/ai-ui/src/markdown.ts"]
    }
  },
  "include": ["packages/*/src", "stories", ".storybook", "tests/visual", "tests/loading", "playwright.config.ts", "playwright.loading.config.ts"]
}
